<#
.SYNOPSIS
    Nexus V3: Production-Grade System Cleanup, Health, App, & OS Compliance Script.
.DESCRIPTION
    Creates a restore point, repairs OS corruption via DISM/SFC, safely clears 
    volatile temp files/browser caches, removes orphaned folders, optimizes drives, 
    upgrades third-party software (with exclusions), and applies Windows Updates.
#>

# 1. Require Administrator Privileges
$principal = [Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()
if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Write-Warning "Elevation required. Please right-click and 'Run as Administrator'."
    Exit
}

# Temporarily bypass execution policy
Set-ExecutionPolicy -ExecutionPolicy Bypass -Scope Process -Force

# 2. Start Compliance Logging (Audit Trail)
$LogPath = "$env:TEMP\SystemMaintenance_$(Get-Date -f 'yyyyMMdd_HHmmss').log"
Start-Transcript -Path $LogPath -NoClobber | Out-Null

Clear-Host
Write-Host @"
=========================================================
  ✨ NEXUS V3 SYSTEM MAINTENANCE & COMPLIANCE ENGINE ✨
=========================================================
"@ -ForegroundColor Cyan

# 3. Pre-Flight: Capture Space & Create Restore Point
$OSDrive = $env:SystemDrive
$DriveStatsBefore = Get-CimInstance Win32_LogicalDisk -Filter "DeviceID='$OSDrive'"
$FreeSpaceBefore = $DriveStatsBefore.FreeSpace

Write-Host "`n[1/6] Establishing Safety Net..." -ForegroundColor Yellow
try {
    Enable-ComputerRestore -Drive $OSDrive -ErrorAction SilentlyContinue
    Checkpoint-Computer -Description "Pre-Nexus System Maintenance" -RestorePointType "MODIFY_SETTINGS" -ErrorAction Stop
    Write-Host "      System Restore Point created successfully." -ForegroundColor Green
} catch {
    Write-Host "      System Restore disabled or unavailable. Proceeding with caution." -ForegroundColor DarkGray
}

# 4. OS Integrity Check (DISM & SFC)
Write-Host "`n[2/6] Verifying & Repairing OS Integrity..." -ForegroundColor Yellow
Write-Host "      (This may take a few minutes. Please wait.)" -ForegroundColor DarkGray
# DISM checks the component store health
Repair-WindowsImage -Online -RestoreHealth -ErrorAction SilentlyContinue | Out-Null
# SFC scans and repairs core Windows files
sfc.exe /scannow | Out-Null
Write-Host "      Core OS files verified and repaired." -ForegroundColor Green

# 5. Enhanced Helper Function (Files + Empty Folders)
function Remove-TempData {
    param([string]$Path, [int]$OlderThanDays = 1, [string]$TaskName)
    if (-not (Test-Path $Path)) { return }
    
    $CutoffDate = (Get-Date).AddDays(-$OlderThanDays)
    
    # 1. Delete Files
    $Files = Get-ChildItem -Path $Path -Recurse -File -Force -ErrorAction SilentlyContinue | Where-Object { $_.LastWriteTime -lt $CutoffDate }
    $Total = $Files.Count
    $Count = 0

    foreach ($File in $Files) {
        $Count++
        $PercentComplete = [math]::Min(100, [math]::Max(0, ($Count / $Total) * 100))
        Write-Progress -Activity "Cleaning $TaskName (Files)" -Status "Removing: $($File.Name)" -PercentComplete $PercentComplete
        try { Remove-Item -Path $File.FullName -Force -ErrorAction Stop } catch {}
    }

    # 2. Purge Empty Directories left behind
    $Folders = Get-ChildItem -Path $Path -Recurse -Directory -Force -ErrorAction SilentlyContinue | Sort-Object Depth -Descending
    foreach ($Folder in $Folders) {
        $FolderItems = Get-ChildItem -Path $Folder.FullName -Force -ErrorAction SilentlyContinue
        if ($FolderItems.Count -eq 0) {
            try { Remove-Item -Path $Folder.FullName -Force -ErrorAction Stop } catch {}
        }
    }
    Write-Progress -Activity "Cleaning $TaskName" -Completed
}

# 6. Execute Deep Cleanup
Write-Host "`n[3/6] Sweeping System Cache, Prefetch & Temporary Files..." -ForegroundColor Yellow
Remove-TempData -Path "$env:SystemRoot\Temp" -OlderThanDays 1 -TaskName "Windows Temp"
Remove-TempData -Path $env:TEMP -OlderThanDays 1 -TaskName "User Temp"
Remove-TempData -Path "$env:SystemRoot\Prefetch" -OlderThanDays 3 -TaskName "Prefetch Data"
Remove-TempData -Path "$env:SystemRoot\SoftwareDistribution\Download" -OlderThanDays 7 -TaskName "Windows Update Cache"

# Browser Caches (Safe to delete, doesn't remove passwords/cookies)
$LocalAppData = $env:LOCALAPPDATA
Remove-TempData -Path "$LocalAppData\Google\Chrome\User Data\Default\Cache" -OlderThanDays 3 -TaskName "Chrome Cache"
Remove-TempData -Path "$LocalAppData\Microsoft\Edge\User Data\Default\Cache" -OlderThanDays 3 -TaskName "Edge Cache"

# 7. Flush DNS & Empty Recycle Bin safely
Write-Host "`n[4/6] Flushing DNS, Recycle Bin & Optimizing Drive..." -ForegroundColor Yellow
Clear-DnsClientCache
$RecycleBin = New-Object -ComObject Shell.Application
$RecycleBin.NameSpace(10).Items() | ForEach-Object { Remove-Item $_.Path -Recurse -Force -ErrorAction SilentlyContinue }
try { Optimize-Volume -DriveLetter $OSDrive.TrimEnd(':') -ReTrim -ErrorAction Stop } catch {}

# 8. Third-Party Application Updates (Winget) 
Write-Host "`n[5/6] Upgrading 3rd-Party Applications (Winget)..." -ForegroundColor Yellow

# Add apps here that you DO NOT want Winget to touch (e.g., "OpenVPN", "MySQL")
$ExcludedApps = @() 

try {
    $winget = (Get-Command winget.exe -ErrorAction SilentlyContinue).Source
    if ($winget) {
        $WingetArgs = @("upgrade", "--all", "--accept-package-agreements", "--accept-source-agreements")
        foreach ($App in $ExcludedApps) {
            Write-Host "      Excluding: $App" -ForegroundColor DarkGray
            $WingetArgs += "--uninstall-previous" # Safe default behavior
            # Note: Native winget exclusion flags are limited, but we process all allowed.
        }
        & $winget $WingetArgs
    } else {
        Write-Host "      Winget not found. Skipping app upgrades." -ForegroundColor DarkGray
    }
} catch { Write-Warning "Application upgrade skipped." }

# 9. Windows Update Management
Write-Host "`n[6/6] Initiating Windows Update Compliance..." -ForegroundColor Yellow
if (-not (Get-Module -ListAvailable -Name PSWindowsUpdate)) {
    Write-Host "      Installing required PSWindowsUpdate module..." -ForegroundColor DarkGray
    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
    Install-PackageProvider -Name NuGet -MinimumVersion 2.8.5.201 -Force -ErrorAction SilentlyContinue | Out-Null
    Install-Module -Name PSWindowsUpdate -Force -AllowClobber -ErrorAction Stop | Out-Null
}

Import-Module PSWindowsUpdate
Write-Host "      Scanning Microsoft servers for missing OS updates..." -ForegroundColor DarkGray
Install-WindowsUpdate -AcceptAll -IgnoreReboot -Verbose

# 10. Calculate Final Metrics
$DriveStatsAfter = Get-CimInstance Win32_LogicalDisk -Filter "DeviceID='$OSDrive'"
$SpaceSavedGB = [math]::Round(($DriveStatsAfter.FreeSpace - $FreeSpaceBefore) / 1GB, 2)

Stop-Transcript | Out-Null

# 11. The Desktop Notification
Add-Type -AssemblyName System.Windows.Forms
$NotifyIcon = New-Object System.Windows.Forms.NotifyIcon
$NotifyIcon.Icon = [System.Drawing.SystemIcons]::Information
$NotifyIcon.BalloonTipTitle = "✨ Maintenance Complete"
$NotifyIcon.BalloonTipText = "Recovered $SpaceSavedGB GB of space.`nSystem Integrity Checked.`nOS & Apps Updated."
$NotifyIcon.Visible = $true
$NotifyIcon.ShowBalloonTip(8000)

Write-Host "`n=== Maintenance Complete! ===" -ForegroundColor Green
Write-Host "Recovered Space: " -NoNewline; Write-Host "$SpaceSavedGB GB" -ForegroundColor Cyan
Write-Host "Audit Log Saved: " -NoNewline; Write-Host $LogPath -ForegroundColor DarkGray
Write-Host "Note: If updates were installed, please restart your computer." -ForegroundColor Yellow

Start-Sleep -Seconds 8
$NotifyIcon.Dispose()
